# shellcheck shell=bash
# S3 / object-store target for the benchmark's Iceberg store — the SINGLE source of truth every
# component (Polaris catalog, engine, Spark connector/maintenance, generator, Data Prepper, Trino)
# is rendered from. Sourced by scale-up.sh; the vars are exported for `envsubst` + `helm --set`.
#
# DEFAULT is the in-cluster single MinIO pod (unchanged local/CI behaviour). Set S3_PROFILE=hetzner to
# back Iceberg on the SAME Hetzner Object Storage bucket used for run artifacts (bench/scale/artifacts.sh),
# under a path PREFIX — same region (nbg1) as the ccx43 cluster, so hydration GETs stay in-region.
#
# Hetzner credentials are NOT committed: they are read at deploy time from the artifacts creds file
# (~/.ssh/hetzner-gdb-storage, ACCESS_KEY=/SECRET_KEY= lines) — the same file artifacts.sh uses.

S3_PROFILE="${S3_PROFILE:-minio}"

case "$S3_PROFILE" in
  minio)
    : "${S3_ENDPOINT:=http://minio:9000}"     # scheme decides TLS for the engine (iceberg-rust)
    : "${S3_REGION:=us-east-1}"
    : "${S3_PATH_STYLE:=true}"
    : "${S3_SSL:=false}"                        # Spark s3a connection.ssl.enabled
    : "${S3_WAREHOUSE_BASE:=s3://growlerdb-warehouse/growlerdb}"
    : "${S3_ALLOWED_LOCATION:=s3://growlerdb-warehouse/}"
    : "${S3_ACCESS_KEY:=minioadmin}"
    : "${S3_SECRET_KEY:=minioadmin}"
    S3_DEPLOY_MINIO=true                        # bring up the in-cluster MinIO pod
    ;;
  hetzner)
    # Same bucket as artifacts (growlerdb), Iceberg under the `iceberg/` PREFIX; nbg1 = cluster region.
    : "${HETZNER_S3_ENDPOINT:=https://nbg1.your-objectstorage.com}"
    : "${HETZNER_S3_BUCKET:=growlerdb}"
    : "${HETZNER_S3_PREFIX:=iceberg}"
    : "${HETZNER_S3_REGION:=nbg1}"
    : "${HETZNER_CRED_FILE:=$HOME/.ssh/hetzner-gdb-storage}"
    if [ -z "${S3_ACCESS_KEY:-}" ] || [ -z "${S3_SECRET_KEY:-}" ]; then
      [ -r "$HETZNER_CRED_FILE" ] || { echo "FATAL: S3_PROFILE=hetzner needs $HETZNER_CRED_FILE (ACCESS_KEY=/SECRET_KEY=) or S3_ACCESS_KEY/S3_SECRET_KEY set" >&2; exit 1; }
      # shellcheck disable=SC1090
      . "$HETZNER_CRED_FILE"
      : "${S3_ACCESS_KEY:=$ACCESS_KEY}"
      : "${S3_SECRET_KEY:=$SECRET_KEY}"
    fi
    : "${S3_ENDPOINT:=$HETZNER_S3_ENDPOINT}"
    : "${S3_REGION:=$HETZNER_S3_REGION}"
    : "${S3_PATH_STYLE:=true}"
    : "${S3_SSL:=true}"
    : "${S3_WAREHOUSE_BASE:=s3://$HETZNER_S3_BUCKET/$HETZNER_S3_PREFIX/growlerdb}"
    : "${S3_ALLOWED_LOCATION:=s3://$HETZNER_S3_BUCKET/$HETZNER_S3_PREFIX/}"
    S3_DEPLOY_MINIO=false                       # object store is remote — no in-cluster MinIO
    ;;
  *)
    echo "FATAL: unknown S3_PROFILE='$S3_PROFILE' (want minio|hetzner)" >&2; exit 1 ;;
esac

export S3_ENDPOINT S3_REGION S3_PATH_STYLE S3_SSL S3_WAREHOUSE_BASE S3_ALLOWED_LOCATION \
       S3_ACCESS_KEY S3_SECRET_KEY S3_DEPLOY_MINIO
